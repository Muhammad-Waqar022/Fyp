PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce-backend
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PAYMENT_CURRENCY=usd
# Stripe test mode: configure these only when testing Stripe Checkout.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PAYMENT_RETURN_URL=http://localhost:3000
# Used only by `npm run admin:create`. Do not share or commit real credentials.
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
