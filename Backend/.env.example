PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce-backend
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PAYMENT_CURRENCY=usd
PAYMENT_RESERVATION_HOURS=24
# Manual transfer details shown to customers. Set these before enabling the payment methods.
JAZZCASH_ACCOUNT_TITLE=
JAZZCASH_ACCOUNT_NUMBER=
EASYPAISA_ACCOUNT_TITLE=
EASYPAISA_ACCOUNT_NUMBER=
BANK_ACCOUNT_TITLE=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
# Used only by `npm run admin:create`. Do not share or commit real credentials.
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
